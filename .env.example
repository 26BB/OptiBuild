# ==========================================
# OptiBuild Monorepo Environment Configuration
# ==========================================

# Backend Settings
PROJECT_NAME="OptiBuild Construction Scheduling & Resource Optimization Engine"
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
JWT_SECRET=
BACKEND_URL=
FRONTEND_URL=

# Database (PostgreSQL / Supabase)
# For local Docker PostgreSQL:
DATABASE_URL=postgresql://optibuild:optibuild_secret@postgres:5432/optibuild_db
# For Supabase PostgreSQL (replace with your project ref & password):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# S3-compatible Object Storage (MinIO / Supabase Storage / Cloudflare R2 / AWS S3)
# For local MinIO:
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=optibuild_minio_admin
S3_SECRET_KEY=optibuild_minio_secret
S3_BUCKET_NAME=optibuild-artifacts
S3_REGION=us-east-1

# For Supabase S3 Storage (Project Settings -> Storage -> S3 Access Keys):
# S3_ENDPOINT_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
# S3_ACCESS_KEY=[YOUR-SUPABASE-S3-ACCESS-KEY]
# S3_SECRET_KEY=[YOUR-SUPABASE-S3-SECRET-KEY]
# S3_BUCKET_NAME=optibuild-artifacts
# S3_REGION=ap-south-1

# Optional: Supabase Client & Project API URL
# NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_NAME="OptiBuild Site Engine"
