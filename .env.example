# ==========================================
# OptiBuild Monorepo Environment Configuration
# ==========================================

# Backend Settings
PROJECT_NAME="OptiBuild Construction Scheduling & Resource Optimization Engine"
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
JWT_SECRET=your_32_character_jwt_secret_key_here
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MAX_PROJECT_STORAGE_MB=200

# Database Configuration
# Default: Local SQLite for zero-dependency development
DATABASE_URL=sqlite:///./optibuild.db

# For Neon Serverless PostgreSQL (Production):
# DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Or Neon Pooled Connection:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint]-pooler.neon.tech/neondb?sslmode=require

# For local Docker PostgreSQL:
# DATABASE_URL=postgresql://optibuild:optibuild_secret@postgres:5432/optibuild_db

# S3-compatible Object Storage (MinIO / Supabase Storage / Cloudflare R2 / AWS S3)
# For local MinIO:
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=optibuild_minio_admin
S3_SECRET_KEY=optibuild_minio_secret
S3_BUCKET_NAME=optibuild-artifacts
S3_REGION=us-east-1

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_NAME="OptiBuild Site Engine"
